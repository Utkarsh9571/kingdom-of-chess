# -----------------------------------------------------------------------------
# Kingdom of Chess — Environment Configuration Example
# -----------------------------------------------------------------------------

# PostgreSQL Database Configuration
# Supports both local PostgreSQL containers and managed Cloud PostgreSQL (e.g. Neon PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=kingdom_chess
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/kingdom_chess
# Example for Neon/Cloud PostgreSQL with SSL:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Backend Service Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_for_kingdom_chess_2026_dev_only
FRONTEND_URL=http://localhost:3000

# Frontend Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
